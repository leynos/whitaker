## टेस्ट संदर्भों के बाहर `expect` कॉल प्रतिबंधित हैं।

no_expect_outside_tests = केवल टेस्ट के लिए बने कोड के बाहर { $receiver } पर `expect` कॉल करने से बचें।
    .note = यह कॉल “{ $context }” के भीतर से आती है, जिसे टेस्ट के रूप में नहीं पहचाना गया है।
    .help = { $handling ->
        [option] { $receiver } के `None` वैरिएंट को सँभालें या कोड को किसी टेस्ट में ले जाएँ।
        [result] { $receiver } के `Err` वैरिएंट को सँभालें या कोड को किसी टेस्ट में ले जाएँ।
       *[other] { $receiver } के त्रुटि पथ को सँभालें या कोड को किसी टेस्ट में ले जाएँ।
    }
