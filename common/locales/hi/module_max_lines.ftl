## मॉड्यूल की लंबाई संबंधी मार्गदर्शन।

module_max_lines = { $lines ->
        [one] मॉड्यूल { $module } में { $lines } पंक्ति है, जो अनुमत सीमा { $limit } से अधिक है।
       *[other] मॉड्यूल { $module } में { $lines } पंक्तियाँ हैं, जो अनुमत सीमा { $limit } से अधिक हैं।
    }
    .note = बड़े मॉड्यूल में नेविगेट करना और उनकी समीक्षा करना अधिक कठिन होता है।
    .help = { $module } को छोटे मॉड्यूलों में बाँटें या उसकी ज़िम्मेदारियाँ घटाएँ।
