## גלאי המורכבות "Bumpy Road".

bumpy_road_function = קיימים כמה אשכולות של לוגיקה מותנית מקוננת ב-`{ $name }`.
    .note = { $count ->
        [one] זוהתה גבשושית מורכבות אחת מעל הסף { $threshold }.
        [two] זוהו שתי גבשושיות מורכבות מעל הסף { $threshold }.
        [many] זוהו { $count } גבשושיות מורכבות מעל הסף { $threshold }.
       *[other] זוהו { $count } גבשושיות מורכבות מעל הסף { $threshold }.
    }
    .help = יש לחלץ פונקציות עזר מהאזורים המודגשים כדי להפחית את המורכבות המקובצת.
    .label = { $lines ->
        [one] גבשושית מורכבות { $index } משתרעת על שורה אחת.
        [two] גבשושית מורכבות { $index } משתרעת על שתי שורות.
        [many] גבשושית מורכבות { $index } משתרעת על { $lines } שורות.
       *[other] גבשושית מורכבות { $index } משתרעת על { $lines } שורות.
    }
